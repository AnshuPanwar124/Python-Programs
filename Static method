class Employee:
    no_of_leaves = 8   #Class variable is class Property, It is shared by all instances of that class.

    def __init__(self, name, salary, role): #Constructor is used for initialize the object ,called automatically when an object is created from a class.
        self.name = name
        self.salary = salary
        self.role = role
     
    def printdetails(self):
        return f"Name is {self.name}. Salary is {self.salary} and role is {self.role}"
    
    @classmethod             # It is bound to the class itself, rather than to an instance of the class.
    def change_leaves(cls, newleaves):
        cls.no_of_leaves=newleaves

    @classmethod
    def from_str(cls, string):
        #param = string.split("-") #It will split the string from '-'
        #return cls(param[0],param[1],param[2])

        return cls(*string.split("-"))
    
    @staticmethod   #It is utility-type methods belongs to class but functionality does not depend on state of any particular object of class, It cannot access or modify class state.
    def printgood(string):
        print("This is good " + string)
        return "abc"

rohan = Employee("Rohan", 255, "Instructor")
harry = Employee("Harry", 455, "Instructor")
karan = Employee.from_str("Karan-480-Student")
print(karan.salary)

harry.change_leaves(34)

#Employee.no_of_leaves = 9
print(harry.no_of_leaves)
print(Employee.printgood("abc"))